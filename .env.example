# Copy to `.env` and fill in real values. NEVER commit `.env` (it's gitignored).
#
# Postgres connection for the birdwatcher detections table. The home listener
# writes here; the dashboard (local or Posit Connect Cloud) reads from it.
# Use a dedicated `birdwatcher` role scoped to the birdwatcher schema only.
DB_HOST=your-db-host.example.com
DB_PORT=5432
DB_NAME=your_database
DB_USER=birdwatcher
DB_PASS=

# Schema holding the birdwatcher tables (keeps it isolated from other apps).
BW_DB_SCHEMA=birdwatcher

# Alternatively, supply a full SQLAlchemy URL instead of the DB_* parts above:
# BW_DATABASE_URL=postgresql+psycopg2://birdwatcher:PASSWORD@your-db-host.example.com:5432/your_database

# Local wall-clock timezone for "today"/hourly buckets (default America/New_York).
# BW_TIMEZONE=America/New_York

# Microphone selection: a device-name substring or an index. See list_devices.
# BW_INPUT_DEVICE=UAC

# --- iPhone widget feed (optional) ---
# Set the bucket to publish a public latest.json to S3 for the phone widget.
# Leave it unset to disable the feed entirely.
# BW_FEED_S3_BUCKET=my-bucket
# BW_FEED_S3_KEY=birdwatcher/latest.json
# BW_FEED_S3_REGION=us-east-1
# BW_FEED_INTERVAL=60
# Only if the bucket still uses ACLs; otherwise use a bucket policy and omit:
# BW_FEED_S3_ACL=public-read
#
# AWS credentials for the S3 upload (standard boto3 env vars):
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Audio clips in the dashboard (optional) ---
# When the feed bucket above is set, each detection's clip is also uploaded to
# S3 so the cloud dashboard can play it (clips otherwise stay on the recording
# machine). Reuses the feed bucket/region/ACL/credentials. Set to 0 to keep the
# JSON feed but never upload audio.
# BW_PUBLISH_CLIPS=1
# BW_CLIPS_S3_PREFIX=birdwatcher/clips

# --- Privacy: human-voice filtering ---
# On by default: if BirdNET hears a human voice in a segment (above the
# confidence below), that segment's clips are kept on the recording machine
# only and never uploaded to the public bucket. The bird detection is still
# recorded — only the audio is withheld. Set to 0 to disable the hold.
# BW_FILTER_HUMAN_VOICE=1
# BW_HUMAN_VOICE_CONF=0.3
